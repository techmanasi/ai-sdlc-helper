{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "paths": {
      "ai-sdlc-helper/review-limit": ["../../src/config/review-limit.ts"],
      "ai-sdlc-helper/editor": ["../../src/config/editor.ts"]
    },
    "types": []
  },
  "include": ["src"]
}
